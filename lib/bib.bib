@article{bastosNeuralEffectsPropofolinduced2021,
  title = {Neural Effects of Propofol-Induced Unconsciousness and Its Reversal Using Thalamic Stimulation},
  author = {Bastos, André M and Donoghue, Jacob A and Brincat, Scott L and Mahnke, Meredith and Yanar, Jorge and Correa, Josefina and Waite, Ayan S and Lundqvist, Mikael and Roy, Jefferson and Brown, Emery N and Miller, Earl K},
  date = {2021-04-27},
  journaltitle = {eLife},
  volume = {10},
  pages = {e60824},
  issn = {2050-084X},
  doi = {10.7554/eLife.60824},
  url = {https://elifesciences.org/articles/60824},
  urldate = {2024-06-17},
  abstract = {The specific circuit mechanisms through which anesthetics induce unconsciousness have not been completely characterized. We recorded neural activity from the frontal, parietal, and temporal cortices and thalamus while maintaining unconsciousness in non-human primates (NHPs) with the anesthetic propofol. Unconsciousness was marked by slow frequency (\textasciitilde 1 Hz) oscillations in local field potentials, entrainment of local spiking to Up states alternating with Down states of little or no spiking activity, and decreased coherence in frequencies above 4 Hz. Thalamic stimulation ‘awakened’ anesthetized NHPs and reversed the electrophysiologic features of unconsciousness. Unconsciousness is linked to cortical and thalamic slow frequency synchrony coupled with decreased spiking, and loss of higher-frequency dynamics. This may disrupt cortical communication/integration.},
  langid = {english},
  keywords = {notion},
  file = {C:\Users\adama\OneDrive\Documents\books\elife-60824-v1.pdf}
}

